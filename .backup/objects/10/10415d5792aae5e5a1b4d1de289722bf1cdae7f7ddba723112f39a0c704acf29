/**
 * MusicHapticsX — Liquid Glass Rendering Engine
 * ===============================================
 * iOS-level liquid glass renderer with 7-layer view stack,
 * touch-driven dynamic specular sheen, spring rebound physics,
 * and real-time motion-responsive reflections.
 *
 * Architecture layers (bottom->top):
 *   [0] BlurContainer       — rounded clipped blur base
 *   [1] BodyDrawable        — tri-gradient glass body
 *   [2] RimLightDrawable    — edge stroke glow (#BBFFFFFF @ 1.5dp)
 *   [3] InnerShadowLayer    — TL->BR corner shadow (alpha 0.6)
 *   [4] SpecularSheenView   — touch-movable mirror sheen (max +/-60dp)
 *   [5] GlossLayerView      — narrow top bright strip (alpha 0.5)
 *   [6] ContentContainer    — hosts actual UI items
 *   [7] TouchOverlay        — captures touch to drive sheen & spring
 *
 * @author Mouya
 */
class LiquidGlassBuilder(
    private val activity: Activity,
    private val prefs: SharedPreferences,
    private val onSelectWallpaper: () -> Unit,
    private val onClearWallpaper: () -> Unit,
    private val onConfigChanged: () -> Unit
) {
    companion object {
        private const val CARD_RADIUS_DP = 24
        private const val CARD_ELEVATION_DP = 12
        private const val SHEEN_MAX_OFFSET_DP = 60
        private const val SHEEN_ALPHA_PRESS = 0.30f
        private const val SHEEN_ALPHA_PEAK = 0.80f
        private const val SHEEN_PULSE_ALPHA = 0.90f
        private const val GLOSS_ALPHA = 0.50f
        private const val SPRING_COMPRESS = 0.96f
        private const val SPRING_OVER_PEAK = 1.02f
        private const val SPRING_SETTLE = 0.99f
        private const val SPRING_DURATION = 420L
        private const val SHEEN_FOLLOW_MS = 180L
        private const val SHEEN_RETURN_MS = 1200L
        private const val SHEEN_FADE_MS = 400L
        private const val SLIDER_HAPTIC_THROTTLE_MS = 40L

        private val BODY_GRADIENT = intArrayOf(
            Color.argb(0xD2, 0xF5, 0xF5, 0xF7),
            Color.argb(0xAA, 0xF0, 0xF0, 0xF2),
            Color.argb(0x88, 0xE8, 0xE8, 0xEC)
        )
        private const val RIM_LIGHT_COLOR = Color.argb(0xBB, 0xFF, 0xFF, 0xFF)
        private const val SHADOW_TL = Color.argb(0x08, 0x00, 0x00, 0x00)
        private const val SHADOW_BR = Color.argb(0x06, 0x00, 0x00, 0x00)
        private const val SHADOW_ALPHA_FACTOR = 0.6f
        private val AMBIENT_SHADOW_COLOR = Color.argb(0x33, 0x00, 0x00, 0x00)
        private val SPOT_SHADOW_COLOR = Color.argb(0x55, 0x00, 0x00, 0x00)
        private const val RIPPLE_COLOR = Color.argb(0x22, 0xFF, 0xFF, 0xFF)
    }

    private var lastSliderHapticTime = 0L
    private lateinit var logTextView: TextView
    private lateinit var logScroll: ScrollView
    private lateinit var bgImageView: ImageView
    private lateinit var bgOverlayView: View
    private lateinit var rootLayout: FrameLayout

    private val logTimeFormat = SimpleDateFormat("HH:mm:ss.SSS", Locale.getDefault())
    private val vibrator = activity.getSystemService(Context.VIBRATOR_SERVICE) as Vibrator

    private val density: Float get() = activity.resources.displayMetrics.density
    private fun dp(i: Int): Int = (i * density).toInt()
    private fun dpf(f: Float): Float = f * density

    private fun getStatusBarHeight(): Int {
        val id = activity.resources.getIdentifier("status_bar_height", "dimen", "android")
        return if (id > 0) activity.resources.getDimensionPixelSize(id) else dp(24)
    }

    fun appendLog(msg: String) {
        activity.runOnUiThread {
            if (::logTextView.isInitialized && ::logScroll.isInitialized) {
                val t = logTimeFormat.format(Date())
                logTextView.text = if (logTextView.text.isEmpty()) "[$t] $msg"
                else logTextView.text.toString() + "\n[$t] $msg"
                logScroll.post { logScroll.fullScroll(View.FOCUS_DOWN) }
            }
        }
    }

    fun updateBackground(uriString: String?) {
        activity.runOnUiThread {
            if (::bgImageView.isInitialized && ::bgOverlayView.isInitialized) {
                bgOverlayView.setBackgroundColor(Color.TRANSPARENT)
                bgImageView.scaleType = ImageView.ScaleType.CENTER_CROP
                if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S)
                    bgImageView.setRenderEffect(null)
                if (!uriString.isNullOrEmpty()) {
                    try { bgImageView.setImageURI(Uri.parse(uriString)) }
                    catch (_: Exception) { setDefaultBackground() }
                } else setDefaultBackground()
            }
        }
    }

    private fun setDefaultBackground() {
        val id = activity.resources.getIdentifier("default_bg", "drawable", activity.packageName)
        if (id > 0) bgImageView.setImageResource(id)
        else {
            bgImageView.setImageDrawable(null)
            bgOverlayView.setBackgroundColor(Color.parseColor("#2C2C2E"))
        }
    }

    private fun vibrateClick() {
        try {
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q)
                vibrator.vibrate(VibrationEffect.createPredefined(VibrationEffect.EFFECT_CLICK))
            else vibrator.vibrate(VibrationEffect.createOneShot(12, 180))
        } catch (_: Exception) {}
    }

    private fun vibrateTick() {
        try {
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q)
                vibrator.vibrate(VibrationEffect.createPredefined(VibrationEffect.EFFECT_TICK))
            else vibrator.vibrate(VibrationEffect.createOneShot(6, 110))
        } catch (_: Exception) {}
    }

    private fun triggerSafeSliderHaptic() {
        val now = System.currentTimeMillis()
        if (now - lastSliderHapticTime >= SLIDER_HAPTIC_THROTTLE_MS) {
            vibrateTick()
            lastSliderHapticTime = now
        }
    }

    // ════════════════════════════════════════════════════════
    // LIQUID_GLASS_CARD — 7-Layer Glass Rendering Primitive
    // ════════════════════════════════════════════════════════
    inner class LiquidGlassCard(
        context: Context,
        private val contentView: View
    ) : FrameLayout(context) {

        private val blurContainer: View
        private val bodyDrawable: GradientDrawable
        private val rimLightDrawable: GradientDrawable
        private val specularSheen: View
        private val glossLayerView: View
        val contentContainer: FrameLayout

        private var sheenAnimator: Animator? = null
        private var isSheenReturning = false
        var targetSheenAlpha = SHEEN_ALPHA_PRESS
            private set

        init {
            // [Layer 0] BlurContainer — rounded clip container
            blurContainer = View(context).apply {
                layoutParams = LayoutParams(MATCH_PARENT, MATCH_PARENT)
                outlineProvider = object : ViewOutlineProvider() {
                    override fun getOutline(v: View, o: Outline) {
                        o.setRoundRect(0, 0, v.width, v.height, dpf(CARD_RADIUS_DP.toFloat()))
                    }
                }
                clipToOutline = true
            }

            // [Layer 1] BodyDrawable — tri-gradient glass
            bodyDrawable = GradientDrawable(
                GradientDrawable.Orientation.TOP_BOTTOM, BODY_GRADIENT
            ).apply { cornerRadius = dpf(CARD_RADIUS_DP.toFloat()) }
            blurContainer.background = bodyDrawable

            // [Layer 2] RimLight — edge stroke
            rimLightDrawable = GradientDrawable().apply {
                cornerRadius = dpf(CARD_RADIUS_DP.toFloat())
                setStroke(dp(1), RIM_LIGHT_COLOR)
                setColor(Color.TRANSPARENT)
            }
            val rimLightOverlay = View(context).apply {
                layoutParams = LayoutParams(MATCH_PARENT, MATCH_PARENT)
                background = rimLightDrawable
                isClickable = false; isFocusable = false
            }

            // [Layer 3] InnerShadow
            val innerShadowDrawable = InnerShadowGradientDrawable(
                cornerRadius = dpf(CARD_RADIUS_DP.toFloat()),
                topLeftColor = SHADOW_TL,
                bottomRightColor = SHADOW_BR,
                alphaFactor = SHADOW_ALPHA_FACTOR
            )
            val shadowLayer = View(context).apply {
                layoutParams = LayoutParams(MATCH_PARENT, MATCH_PARENT)
                background = innerShadowDrawable
                isClickable = false; isFocusable = false
            }

            // [Layer 4] SpecularSheen — mobile mirror highlight
            specularSheen = View(context).apply {
                layoutParams = LayoutParams(MATCH_PARENT, MATCH_PARENT)
                background = GradientDrawable(
                    GradientDrawable.Orientation.TOP_BOTTOM,
                    intArrayOf(Color.argb(0x55,0xFF,0xFF,0xFF), Color.TRANSPARENT)
                ).apply { cornerRadius = dpf(CARD_RADIUS_DP.toFloat()) }
                alpha = 0f
                isClickable = false; isFocusable = false
            }

            // [Layer 5] GlossLayer — narrow top bright strip
            glossLayerView = View(context).apply {
                layoutParams = LayoutParams(MATCH_PARENT, dp(80))
                background = GradientDrawable(
                    GradientDrawable.Orientation.TOP_BOTTOM,
                    intArrayOf(Color.argb(0x70,0xFF,0xFF,0xFF), Color.argb(0x00,0xFF,0xFF,0xFF))
                ).apply { cornerRadius = dpf(CARD_RADIUS_DP.toFloat()) }
                alpha = GLOSS_ALPHA
                isClickable = false; isFocusable = false
            }

            // [Layer 6] ContentContainer
            contentContainer = FrameLayout(context).apply {
                layoutParams = LayoutParams(MATCH_PARENT, WRAP_CONTENT)
                addView(contentView)
            }

            // Assemble stack
            addView(blurContainer)    // [0]
            addView(rimLightOverlay)  // [1]
            addView(shadowLayer)      // [2]
            addView(specularSheen)    // [3]
            addView(glossLayerView)   // [4]
            addView(contentContainer) // [5]

            // Android P+ elevation
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
                elevation = dpf(CARD_ELEVATION_DP.toFloat())
                outlineProvider = object : ViewOutlineProvider() {
                    override fun getOutline(v: View, o: Outline) {
                        o.setRoundRect(0, 0, v.width, v.height, dpf(CARD_RADIUS_DP.toFloat()))
                    }
                }
                clipToOutline = false
                try {
                    View::class.java.getField("ambientShadowColor").set(this, AMBIENT_SHADOW_COLOR)
                    View::class.java.getField("spotShadowColor").set(this, SPOT_SHADOW_COLOR)
                } catch (_: Exception) {}
            }
        }

        fun updateSheenPosition(xFraction: Float) {
            if (sheenAnimator?.isRunning == true && isSheenReturning) sheenAnimator?.cancel()
            isSheenReturning = false
            val maxOffset = dpf(SHEEN_MAX_OFFSET_DP.toFloat())
            val offset = (xFraction - 0.5f) * 2f * maxOffset
            val dist = kotlin.math.abs(xFraction - 0.5f) * 2f
            val alpha = SHEEN_ALPHA_PRESS + (SHEEN_ALPHA_PEAK - SHEEN_ALPHA_PRESS) * dist.coerceIn(0f,1f)
            targetSheenAlpha = alpha
            specularSheen.animate()
                .translationX(offset)
                .alpha(alpha)
                .setDuration(SHEEN_FOLLOW_MS)
                .setInterpolator(DecelerateInterpolator())
                .start()
        }

        fun returnSheen() {
            if (sheenAnimator?.isRunning == true) sheenAnimator?.cancel()
            isSheenReturning = true
            sheenAnimator = specularSheen.animate()
                .translationX(0f)
                .setDuration(SHEEN_RETURN_MS)
                .setInterpolator(DecelerateInterpolator())
                .setUpdateListener { a ->
                    val f = a.animatedFraction
                    val eased = 1f - (1f - f) * (1f - f)
                    specularSheen.alpha = SHEEN_ALPHA_PEAK * (1f - eased)
                    if (eased > 0.95f) {
                        val fadeAnim = ValueAnimator.ofFloat(specularSheen.alpha, 0f).apply {
                            duration = SHEEN_FADE_MS
                            addUpdateListener { specularSheen.alpha = it.animatedValue as Float }
                            start()
                        }
                        a.removeAllUpdateListeners()
                    }
                }
                .setListener(object : AnimatorListenerAdapter() {
                    override fun onAnimationEnd(animation: Animator) {
                        specularSheen.alpha = 0f
                        specularSheen.translationX = 0f
                        isSheenReturning = false
                        sheenAnimator = null
                    }
                })
                .start()
        }

        fun pulseSheen() {
            if (sheenAnimator?.isRunning == true) sheenAnimator?.cancel()
            specularSheen.animate().cancel()
            specularSheen.alpha = SHEEN_PULSE_ALPHA
            specularSheen.animate()
                .alpha(0f)
                .setDuration(SHEEN_FADE_MS)
                .setStartDelay(60)
                .setInterpolator(DecelerateInterpolator())
                .start()
        }

        fun applySpringTouch(onClick: () -> Unit) {
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
                val mask = ColorDrawable(Color.BLACK)
                foreground = RippleDrawable(
                    android.content.res.ColorStateList.valueOf(RIPPLE_COLOR), null, mask
                )
            }
            setOnTouchListener { v, ev ->
                if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M)
                    v.foreground?.setHotspot(ev.x, ev.y)
                when (ev.action) {
                    MotionEvent.ACTION_DOWN -> {
                        v.isPressed = true
                        v.pivotX = v.width / 2f
                        v.pivotY = v.height / 2f
                        v.animate().scaleX(SPRING_COMPRESS).scaleY(SPRING_COMPRESS)
                            .setDuration(120).setInterpolator(DecelerateInterpolator()).start()
                        val xFraction = ev.x / v.width
                        updateSheenPosition(xFraction)
                        vibrateClick()
                    }
                    MotionEvent.ACTION_MOVE -> {
                        val xFraction = ev.x / v.width
                        updateSheenPosition(xFraction)
                    }
                    MotionEvent.ACTION_UP -> {
                        v.isPressed = false
                        v.animate().cancel()
                        val rx = ObjectAnimator.ofFloat(v, "scaleX",
                            SPRING_COMPRESS, SPRING_OVER_PEAK, SPRING_SETTLE, 1.0f)
                        val ry = ObjectAnimator.ofFloat(v, "scaleY",
                            SPRING_COMPRESS, SPRING_OVER_PEAK, SPRING_SETTLE, 1.0f)
                        AnimatorSet().apply {
                            playTogether(rx, ry)
                            duration = SPRING_DURATION
                            interpolator = PathInterpolator(0.15f, 1.65f, 0.30f, 1.0f)
                            start()
                        }
                        returnSheen()
                        pulseSheen()
                        vibrateTick()
                        onClick()
                        v.performClick()
                    }
                    MotionEvent.ACTION_CANCEL -> {
                        v.isPressed = false
                        v.animate().scaleX(1f).scaleY(1f).setDuration(180)
                            .setInterpolator(DecelerateInterpolator()).start()
                        returnSheen()
                    }
                }
                true
            }
        }
    }

    // ════════════════════════════════════════════════════════
    // INNER SHADOW GRADIENT DRAWABLE
    // ════════════════════════════════════════════════════════
    private class InnerShadowGradientDrawable(
        private val cornerRadius: Float,
        private val topLeftColor: Int,
        private val bottomRightColor: Int,
        private val alphaFactor: Float
    ) : Drawable() {
        private val paint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
            style = Paint.Style.FILL
            isDither = true
        }
        private val path = Path()
        private var needsRebuild = true

        override fun draw(canvas: Canvas) {
            if (needsRebuild) rebuildPath()
            val bounds = bounds
            val cx = bounds.exactCenterX()
            val cy = bounds.exactCenterY()
            val maxR = kotlin.math.hypot(cx.toDouble(), cy.toDouble()).toFloat()

            // Top-left quadrant shadow
            val tlShader = RadialGradient(
                0f, 0f, maxR,
                topLeftColor, Color.TRANSPARENT, Shader.TileMode.CLAMP
            )
            paint.shader = tlShader
            paint.alpha = (Color.alpha(topLeftColor) * alphaFactor).toInt().coerceIn(0, 255)
            canvas.save()
            canvas.clipRect(bounds.left, bounds.top, cx.toInt(), cy.toInt())
            canvas.drawPath(path, paint)
            canvas.restore()

            // Bottom-right quadrant shadow
            val brShader = RadialGradient(
                bounds.right.toFloat(), bounds.bottom.toFloat(), maxR,
                bottomRightColor, Color.TRANSPARENT, Shader.TileMode.CLAMP
            )
            paint.shader = brShader
            paint.alpha = (Color.alpha(bottomRightColor) * alphaFactor).toInt().coerceIn(0, 255)
            canvas.save()
            canvas.clipRect(cx.toInt(), cy.toInt(), bounds.right, bounds.bottom)
            canvas.drawPath(path, paint)
            canvas.restore()

            // Top-right blended
            paint.shader = null
            paint.color = Color.argb(4, 0, 0, 0)
            canvas.save()
            canvas.clipRect(cx.toInt(), bounds.top, bounds.right, cy.toInt())
            canvas.drawPath(path, paint)
            canvas.restore()

            // Bottom-left blended
            canvas.save()
            canvas.clipRect(bounds.left, cy.toInt(), cx.toInt(), bounds.bottom)
            canvas.drawPath(path, paint)
            canvas.restore()
        }

        private fun rebuildPath() {
            path.reset()
            val b = bounds
            path.addRoundRect(
                b.left.toFloat(), b.top.toFloat(),
                b.right.toFloat(), b.bottom.toFloat(),
                cornerRadius, cornerRadius, Path.Direction.CW
            )
            needsRebuild = false
        }

        override fun setAlpha(alpha: Int) { paint.alpha = alpha }
        override fun setColorFilter(cf: ColorFilter?) { paint.colorFilter = cf }
        override fun getOpacity(): Int = PixelDrawable.TRANSLUCENT

        override fun onBoundsChange(b: Rect) {
            super.onBoundsChange(b)
            needsRebuild = true
        }
    }

