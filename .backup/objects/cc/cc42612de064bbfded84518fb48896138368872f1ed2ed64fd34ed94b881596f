package com.mouya.musichaptics

import android.content.Context
import android.os.Build
import android.os.VibrationEffect
import android.os.Vibrator
import android.os.VibratorManager
import android.util.Log

/**
 * v4.13.3: RichTap 硬件抽象层（修正版）
 * 
 * 关键修正：
 * - 移除不存在的 android.os.DynamicEffect / HapticPlayer 类引用
 * - 改用 VibrationEffect.Composition API（PRIMITIVE_THUD/CLICK/TICK）
 * - 通过 vibrator HAL 传递到 RichTap 固件（14PRO 模块的实际路径）
 * 
 * 支持厂商：
 * - Xiaomi/Redmi: HyperOS vibrator HAL + RichTap 固件
 * - OnePlus/OPPO: ColorOS haptic HAL
 * - vivo: OriginOS haptic HAL
 */
class RichTapAdapter {
    companion object {
        private const val TAG = "RichTapAdapter"
        
        @Volatile private var sAvailable: Boolean? = null
        @Volatile private var sVibrator: Vibrator? = null
        @Volatile private var sHasAmplitudeControl: Boolean = false
        @Volatile private var sForceDefault: Boolean = false
        
        // Primitive 支持检测
        @Volatile private var sHasThud: Boolean = false
        @Volatile private var sHasClick: Boolean = false
        @Volatile private var sHasTick: Boolean = false
        @Volatile private var sHasLowTick: Boolean = false
        
        /**
         * 初始化 RichTap 适配器
         * 检测 vibrator 能力和 primitive 支持
         */
        fun init(context: android.content.Context): Boolean {
            sAvailable?.let { return it }
            
            return try {
                val vm = context.getSystemService(Context.VIBRATOR_MANAGER_SERVICE) as? VibratorManager
                sVibrator = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
                    vm?.defaultVibrator
                } else {
                    @Suppress("DEPRECATION")
                    context.getSystemService(Context.VIBRATOR_SERVICE) as? Vibrator
                }
                
                val vib = sVibrator
                if (vib == null || !vib.hasVibrator()) {
                    sAvailable = false
                    Log.w(TAG, "No vibrator available")
                    return false
                }
                
                // 检测 amplitude control
                sHasAmplitudeControl = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
                    try { vib.hasAmplitudeControl() } catch (_: Exception) { false }
                } else false
                
                // 检测 primitive 支持
                if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
                    sHasThud = try {
                        vib.areAllPrimitivesSupported(VibrationEffect.Composition.PRIMITIVE_THUD)
                    } catch (_: Exception) { false }
                    sHasClick = try {
                        vib.areAllPrimitivesSupported(VibrationEffect.Composition.PRIMITIVE_CLICK)
                    } catch (_: Exception) { false }
                    sHasTick = try {
                        vib.areAllPrimitivesSupported(VibrationEffect.Composition.PRIMITIVE_TICK)
                    } catch (_: Exception) { false }
                    
                    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
                        sHasLowTick = try {
                            vib.areAllPrimitivesSupported(VibrationEffect.Composition.PRIMITIVE_LOW_TICK)
                        } catch (_: Exception) { false }
                    }
                }
                
                // Xiaomi 10 系列 HAL quirk 检测
                val mfr = Build.MANUFACTURER.lowercase()
                val device = Build.DEVICE.lowercase()
                if (mfr == "xiaomi" && (device.contains("umi") || device.contains("cmi") || device.contains("thyme") || device.contains("g2"))) {
                    sForceDefault = true
                    Log.w(TAG, "Xiaomi HAL quirk detected — forcing DEFAULT_AMPLITUDE")
                }
                
                sAvailable = true
                Log.i(TAG, "RichTap initialized: ampCtrl=$sHasAmplitudeControl THUD=$sHasThud CLICK=$sHasClick TICK=$sHasTick forceDefault=$sForceDefault")
                true
            } catch (e: Exception) {
                sAvailable = false
                Log.w(TAG, "RichTap init failed: ${e.message}")
                false
            }
        }
        
        /**
         * 触发 RichTap 振动（使用 Composition API）
         * 
         * @param event 节拍类型：KICK/SNARE/TICK/BODY
         * @param intensity 强度 0-255
         * @param mode 震感模式（暂未使用，保留接口兼容）
         * @param boost 是否增强（全振幅）
         */
        fun triggerPulse(event: String, intensity: Int, mode: String = "balanced", boost: Boolean = false): Boolean {
            val vib = sVibrator ?: return false
            
            // 归一化强度
            val scale = (intensity.coerceIn(0, 255) / 255f).coerceIn(0.05f, 1.0f)
            val actualScale = if (boost) 1.0f else scale
            
            return try {
                // 根据事件类型选择 primitive
                val (primitiveId, primitiveName) = when (event.uppercase()) {
                    "KICK", "BODY" -> {
                        if (sHasThud) Pair(VibrationEffect.Composition.PRIMITIVE_THUD, "THUD")
                        else if (sHasClick) Pair(VibrationEffect.Composition.PRIMITIVE_CLICK, "CLICK")
                        else null
                    }
                    "SNARE" -> {
                        if (sHasClick) Pair(VibrationEffect.Composition.PRIMITIVE_CLICK, "CLICK")
                        else if (sHasThud) Pair(VibrationEffect.Composition.PRIMITIVE_THUD, "THUD")
                        else null
                    }
                    "TICK", "HIHAT" -> {
                        if (sHasTick) Pair(VibrationEffect.Composition.PRIMITIVE_TICK, "TICK")
                        else if (sHasLowTick && Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
                            Pair(VibrationEffect.Composition.PRIMITIVE_LOW_TICK, "LOW_TICK")
                        }
                        else if (sHasClick) Pair(VibrationEffect.Composition.PRIMITIVE_CLICK, "CLICK")
                        else null
                    }
                    else -> {
                        if (sHasThud) Pair(VibrationEffect.Composition.PRIMITIVE_THUD, "THUD")
                        else if (sHasClick) Pair(VibrationEffect.Composition.PRIMITIVE_CLICK, "CLICK")
                        else null
                    }
                }
                
                if (primitiveId != null) {
                    // 使用 Composition API
                    val composition = VibrationEffect.startComposition()
                    composition.addPrimitive(primitiveId, actualScale, 0)
                    vib.vibrate(composition.compose())
                    Log.i(TAG, "triggerPulse: $event → $primitiveName scale=$actualScale boost=$boost")
                    true
                } else {
                    // Fallback: waveform
                    fallbackOneShot(vib, intensity, event)
                }
            } catch (e: Exception) {
                Log.w(TAG, "Composition failed, fallback: ${e.message}")
                fallbackOneShot(vib, intensity, event)
            }
        }
        
        /**
         * Fallback: 使用 waveform one-shot
         */
        private fun fallbackOneShot(vib: Vibrator, intensity: Int, event: String): Boolean {
            return try {
                val dur = when (event.uppercase()) {
                    "KICK", "BODY" -> 45L
                    "SNARE" -> 30L
                    "TICK", "HIHAT" -> 12L
                    else -> 25L
                }
                val amp = if (sForceDefault || !sHasAmplitudeControl) {
                    VibrationEffect.DEFAULT_AMPLITUDE
                } else {
                    intensity.coerceIn(1, 255)
                }
                vib.vibrate(VibrationEffect.createOneShot(dur, amp))
                Log.i(TAG, "fallbackOneShot: $event dur=${dur}ms amp=$amp")
                true
            } catch (e: Exception) {
                Log.w(TAG, "fallbackOneShot failed: ${e.message}")
                false
            }
        }
        
        /**
         * 获取最小间隔（ms）
         */
        fun getMinIntervalMs(mode: String): Long = when (mode) {
            "pure" -> 260L
            "crisp" -> 60L
            "immersive" -> 80L
            "bass" -> 100L
            "soft" -> 90L
            else -> 75L
        }
        
        /** 确保系统属性已开启（通过 resetprop） */
        fun ensureSystemProps() {
            try {
                Runtime.getRuntime().exec("resetprop sys.haptic.dynamiceffect true")
                Runtime.getRuntime().exec("resetprop sys.haptic.media true")
                Runtime.getRuntime().exec("resetprop sys.haptic.dynamiceffect.richtap true")
                Log.i(TAG, "System props set via resetprop")
            } catch (e: Exception) {
                Log.w(TAG, "ensureSystemProps failed: ${e.message}")
            }
        }
    }
}