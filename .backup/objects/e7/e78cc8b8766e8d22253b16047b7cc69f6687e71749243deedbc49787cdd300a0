package com.mouya.musichaptics

import android.app.Activity
import android.content.SharedPreferences
import android.view.View

/**
 * MusicHapticsX Main UI Builder — Legacy Compatibility Proxy
 * ===========================================================
 * Delegates all rendering to LiquidGlassBuilder (the true liquid glass engine).
 * Preserves the public API for any external callers that still reference MainUiBuilder.
 *
 * To migrate: swap `MainUiBuilder(...)` with `LiquidGlassBuilder(...)` directly.
 */
class MainUiBuilder(
    private val activity: Activity,
    private val prefs: SharedPreferences,
    private val onSelectWallpaper: () -> Unit,
    private val onClearWallpaper: () -> Unit,
    private val onConfigChanged: () -> Unit
) {
    private val engine = LiquidGlassBuilder(
        activity = activity,
        prefs = prefs,
        onSelectWallpaper = onSelectWallpaper,
        onClearWallpaper = onClearWallpaper,
        onConfigChanged = onConfigChanged
    )

    /** Delegated: append a log message to the Liquid Glass log panel */
    fun appendLog(msg: String) = engine.appendLog(msg)

    /** Delegated: update the wallpaper background */
    fun updateBackground(uriString: String?) = engine.updateBackground(uriString)

    /** Delegated: build the full Liquid Glass UI view */
    fun buildView(): View = engine.buildView()
}
