<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>

    <!-- Declare launcher package visibility. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- Keep the application icon. -->
    <application 
        android:allowBackup="false"
        android:name=".MusicHapticsApplication"
        android:icon="@mipmap/ic_launcher"
        android:label="MusicHapticsX" 
        android:supportsRtl="true"
        android:theme="@style/Theme.MusicHaptics">

        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="音乐音频拦截与振动协同模块" />
        <meta-data android:name="xposedminversion" android:value="82" />
        <meta-data android:name="xposedscope" android:resource="@array/xposed_scope" />
        <!-- Advertise dynamic injection capability when supported by the LSPosed manager. -->
        <meta-data android:name="xposed.dynamic.support" android:value="true" />

        <provider android:name="com.itsaky.androidide.logsender.utils.LogSenderInstaller" tools:node="remove" />
        <service android:name="com.itsaky.androidide.logsender.LogSenderService" tools:node="remove" />
        
        <!-- Read-only configuration bridge for enabled hooked packages. -->
        <provider
            android:name=".ConfigProvider"
            android:authorities="com.mouya.musichaptics.provider"
            android:exported="true" />

        <!-- Main entry point. -->
        <activity 
            android:name=".MainActivity" 
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        
        
        <!-- Dashboard. -->
        <activity
            android:name=".HapticDashboardActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|density|uiMode"
            android:theme="@style/Theme.MusicHaptics"
            android:enableOnBackInvokedCallback="true">
            <!-- Android 16: opt out of forced resizability on large screens so
                 our portrait-only Dashboard doesn't get stretched/recreated. -->
            <property
                android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
                android:value="true" />
        </activity>

        <!-- Cross-process vibration proxy for apps that lack VIBRATE permission. -->
        <!-- No permission restriction: the whole point is that callers LACK VIBRATE.
             Security: only useful for vibration, no sensitive data exposed. -->
        <service
            android:name=".VibrateProxyService"
            android:exported="true" />

    </application>
</manifest>