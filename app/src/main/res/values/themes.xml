<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Opaque bar colors prevent OEM letterbox/black-strip artifacts while the
         dashboard itself lays out below the status bar with a deliberate top inset. -->
    <style name="Theme.MusicHaptics" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowActionModeOverlay">true</item>
        <!-- Must match the light Compose canvas until Activity.onCreate applies
             the current light/dark palette. This avoids a black startup strip. -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">#F2F2F7</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F2F2F7</item>
        <item name="android:navigationBarColor">#F2F2F7</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>