<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- v4.6: Re-enabled window preview for fast startup animation.
         Previous windowDisablePreview=true caused a blank screen when
         tapping the launcher icon — no splash/animation was visible. -->
    <style name="Theme.MusicHaptics" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:colorBackgroundCacheHint">#F2F2F7</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F2F2F7</item>
        <item name="android:navigationBarColor">#F2F2F7</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>